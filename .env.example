# ==============================================================================
# AetherDrive (GDrive Clone) - Environment Configuration Template
# DO NOT COMMIT SENSITIVE SECRETS OR PASSWORDS TO VERSION CONTROL
# Copy this file to .env and adjust variables for your target environment (DEV/QA/PROD)
# ==============================================================================

# Application Environment (local, dev, qa, prod)
APP_ENV=local
APP_PORT=8080
FRONTEND_PORT=3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drivedb
DB_USER=driveuser
DB_PASSWORD=change-me-to-a-secure-password
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=${REDIS_HOST}
SPRING_DATA_REDIS_PORT=${REDIS_PORT}

# RabbitMQ Event Messaging
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
SPRING_RABBITMQ_HOST=${RABBITMQ_HOST}
SPRING_RABBITMQ_PORT=${RABBITMQ_PORT}

# Storage Service Configuration (Local Storage Only - No Cloud/R2 required)
STORAGE_TYPE=local
STORAGE_LOCAL_DIRECTORY=/app/data/storage

# Security & Cryptography (JWT 256-bit entropy required in production)
JWT_SECRET=change-me-to-a-secure-random-256-bit-secret-for-jwt-signing
SECURITY_MASTER_KEY=change-me-32-character-secret-key-encryption

# Observability & Monitoring
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
